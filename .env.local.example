# ─────────────────────────────────────────────────────────────────────────────
# Velora Shop — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# Public Supabase client configuration (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only Supabase service role key. NEVER exposed to the browser.
# Used by admin actions and server-side data mutations.
SUPABASE_SERVICE_ROLE_KEY=""

# Canonical site URL (used for metadata / Open Graph / sitemap).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"